@using System.Globalization
@using DocAlchemy.Core.Models

@if (Confidence is null)
{
    <span class="confidence">Not available</span>
}
else if (IsBelowThreshold)
{
    <span class="confidence confidence--warning">
        <svg class="confidence__icon" aria-hidden="true" viewBox="0 0 16 16" focusable="false">
            <path d="M8 1.25 15 14H1L8 1.25Zm-.75 4v4.25h1.5V5.25h-1.5Zm0 5.25V12h1.5v-1.5h-1.5Z" />
        </svg>
        <span>Low confidence: @FormattedConfidence</span>
    </span>
}
else
{
    <span class="confidence">Confidence: @FormattedConfidence</span>
}

@code {
    /// <summary>Gets or sets the optional confidence value.</summary>
    [Parameter]
    public double? Confidence { get; set; }

    /// <summary>Gets or sets the threshold captured by the analysis.</summary>
    [Parameter, EditorRequired]
    public double Threshold { get; set; }

    private bool IsBelowThreshold => ConfidenceThreshold.IsBelow(Confidence, Threshold);

    private string FormattedConfidence => Confidence is double value
        ? $"{(value * 100).ToString("0.##", CultureInfo.InvariantCulture)}%"
        : "Not available";
}
